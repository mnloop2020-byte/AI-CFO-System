// schema.prisma
// This file is the database blueprint.
// Prisma reads this file and generates Prisma Client.
// Migrations use this schema to create/update tables in PostgreSQL.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"] // أضفنا هذا السطر لتفعيل الإضافات
}

datasource db {
  provider   = "postgresql"
  extensions = [vector] // هذا السطر يخبر قاعدة البيانات بتفعيل الذكاء الاصطناعي
}

// Stores application users.
model User {
  id       String @id @default(uuid())
  email    String @unique
  password String
}

// Stores a chat conversation.
model Conversation {
  id        String   @id @default(cuid())
  createdAt DateTime @default(now())

  // One conversation can have many messages.
  messages  Message[]
}

// Stores messages between the user and the AI.
model Message {
  id        String   @id @default(cuid())
  role      String
  content   String
  createdAt DateTime @default(now())

  // Link this message to a conversation.
  conversationId String
  conversation   Conversation @relation(fields: [conversationId], references: [id])
}

// Stores document chunks for RAG.
// Each record = one chunk of text.

model DocumentChunk {
  id        String   @id @default(cuid())

  // The actual text of the chunk.
  content   String

  // Optional source, for example: "test-text" or "file.pdf".
  source    String?

  createdAt DateTime @default(now())

  // Later, after pgvector works, we will add:
  
   embedding Unsupported("vector(1536)")
}